<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+.
   The EncryptedSharedPreferences master key lives in the Android Keystore and
   cannot be restored on another device, so restoring the token file would make
   it unreadable. Exclude it from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="servex_tokens.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="servex_tokens.xml"/>
    </device-transfer>
</data-extraction-rules>
